# ============================================================================
# HAProxy Wildcard SSL Configuration Template
# ============================================================================
# Copy this file to .env and configure the values for your environment
# 
# IMPORTANT: 
# - Set proper file permissions: chmod 600 .env
# - Never commit .env to version control
# - Review all settings before deployment
# ============================================================================

# ============================================================================
# CORE CONFIGURATION
# ============================================================================

# Let's Encrypt Configuration
# Your email address for Let's Encrypt certificate registration and notifications
LETSENCRYPT_EMAIL=admin@example.com

# Domain Configuration
# Primary domain for wildcard certificate (*.yourdomain.com)
DOMAIN=yourdomain.com

# ============================================================================
# DNS PROVIDER CONFIGURATION
# ============================================================================

# DNS Provider Plugin
# Supported providers: dns-cloudflare, dns-route53, dns-digitalocean, dns-google, dns-ovh
# This determines which Certbot plugin to use for DNS-01 challenge
DNS_PLUGIN=dns-cloudflare

# DNS Provider Credentials
# Create the appropriate credentials file in dns-credentials/ directory:
# - Cloudflare: dns-credentials/cloudflare.ini
# - Route53: dns-credentials/route53.ini
# - DigitalOcean: dns-credentials/digitalocean.ini
# - Google: dns-credentials/google.ini
# - OVH: dns-credentials/ovh.ini
#
# Use scripts/setup-dns-provider.sh to help configure your provider

# Certbot Docker Images (automatically set based on DNS_PLUGIN)
# Override only if you need a specific version
CERTBOT_IMAGE=certbot/dns-cloudflare:latest

# ============================================================================
# CERTIFICATE MANAGEMENT
# ============================================================================

# Certificate Renewal Schedule (cron format)
# Default: every 12 hours at minute 0
RENEWAL_CRON_SCHEDULE=0 */12 * * *

# Certificate Monitoring Thresholds (days before expiration)
CERT_WARNING_DAYS=30
CERT_CRITICAL_DAYS=7

# Certificate renewal behavior
RENEWAL_THRESHOLD_DAYS=30
FORCE_RENEWAL_DAYS=7

# ============================================================================
# HAPROXY CONFIGURATION
# ============================================================================

# HAProxy Statistics Interface
HAPROXY_STATS_USER=admin
STATS_PASSWORD=change_this_secure_password_123

# HAProxy Logging
LOG_LEVEL=info
LOG_RETENTION_DAYS=30

# HAProxy Performance Tuning
HAPROXY_MAXCONN=4096
HAPROXY_TIMEOUT_CONNECT=5s
HAPROXY_TIMEOUT_CLIENT=50s
HAPROXY_TIMEOUT_SERVER=50s

# ============================================================================
# BACKEND DISCOVERY
# ============================================================================

# Backend Service Discovery
BACKEND_DISCOVERY_ENABLED=true
BACKEND_DISCOVERY_INTERVAL=60
NETWORK_NAME=proxy-network

# Configuration Management
CONFIG_WATCH_INTERVAL=10
CONFIG_DEBOUNCE_TIME=30
MAX_CONFIG_RELOAD_ATTEMPTS=3
CONFIG_RELOAD_COOLDOWN=120
CONFIG_WATCHER_VERBOSE=false

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================

# SSL/TLS Security Configuration
SSL_MIN_VERSION=TLSv1.2
SSL_CIPHER_SUITE=ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256

# Security Headers Configuration
HSTS_MAX_AGE=63072000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true

# Content Security Policy (customize for your applications)
CSP_POLICY=default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; media-src 'self'; object-src 'none'; child-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'

# Additional Security Headers
X_CONTENT_TYPE_OPTIONS=nosniff
X_FRAME_OPTIONS=SAMEORIGIN
X_XSS_PROTECTION=1; mode=block
REFERRER_POLICY=strict-origin-when-cross-origin

# Rate Limiting (requests per time window)
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=10s

# ============================================================================
# MONITORING AND ALERTING
# ============================================================================

# Alert Configuration
ALERT_EMAIL=admin@example.com
WEBHOOK_URL=

# Monitoring Intervals (seconds)
HEALTH_CHECK_INTERVAL=30
CERTIFICATE_CHECK_INTERVAL=3600
HAPROXY_MONITOR_INTERVAL=300

# Alert Thresholds
CPU_ALERT_THRESHOLD=80
MEMORY_ALERT_THRESHOLD=80
DISK_ALERT_THRESHOLD=85

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log Rotation
LOG_ROTATE_FREQUENCY=daily
LOG_COMPRESS=true
LOG_RETENTION_DAYS=30
LOG_MAX_SIZE=100M

# Syslog Configuration
SYSLOG_FACILITY=local0
SYSLOG_LEVEL=info

# ============================================================================
# DOCKER CONFIGURATION
# ============================================================================

# Container Resource Limits
HAPROXY_MEMORY_LIMIT=512m
HAPROXY_CPU_LIMIT=1.0
CERTBOT_MEMORY_LIMIT=256m
CERTBOT_CPU_LIMIT=0.5

# Container Restart Policies
RESTART_POLICY=unless-stopped

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3
HEALTH_CHECK_START_PERIOD=40s

# ============================================================================
# DEVELOPMENT/TESTING CONFIGURATION
# ============================================================================

# Development Mode (set to true for testing with staging certificates)
DEVELOPMENT_MODE=false

# Let's Encrypt Staging Server (for testing)
# ACME_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory

# Debug Configuration
DEBUG_MODE=false
VERBOSE_LOGGING=false

# ============================================================================
# ADVANCED CONFIGURATION
# ============================================================================

# Custom HAProxy Configuration
# CUSTOM_HAPROXY_CONFIG_PATH=./config/custom-haproxy.cfg

# Custom Error Pages
# CUSTOM_ERROR_PAGES_PATH=./errors

# Custom Scripts
# CUSTOM_SCRIPTS_PATH=./scripts

# External Integrations
# PROMETHEUS_ENABLED=false
# PROMETHEUS_PORT=9090
# GRAFANA_ENABLED=false
# GRAFANA_PORT=3000

# ============================================================================
# ENVIRONMENT-SPECIFIC OVERRIDES
# ============================================================================

# Production Environment
# ENVIRONMENT=production
# LOG_LEVEL=warn
# DEBUG_MODE=false

# Staging Environment
# ENVIRONMENT=staging
# DEVELOPMENT_MODE=true
# LOG_LEVEL=debug

# Development Environment
# ENVIRONMENT=development
# DEVELOPMENT_MODE=true
# DEBUG_MODE=true
# VERBOSE_LOGGING=true

# ============================================================================
# EXAMPLE CONFIGURATIONS
# ============================================================================

# Example: Cloudflare Configuration
# DNS_PLUGIN=dns-cloudflare
# CERTBOT_IMAGE=certbot/dns-cloudflare:latest
# Create: dns-credentials/cloudflare.ini with your API token

# Example: Route53 Configuration
# DNS_PLUGIN=dns-route53
# CERTBOT_IMAGE=certbot/dns-route53:latest
# Create: dns-credentials/route53.ini with AWS credentials

# Example: High-Security Configuration
# SSL_MIN_VERSION=TLSv1.3
# HSTS_MAX_AGE=31536000
# RATE_LIMIT_REQUESTS=50
# RATE_LIMIT_WINDOW=60s

# Example: High-Performance Configuration
# HAPROXY_MAXCONN=8192
# HAPROXY_MEMORY_LIMIT=1g
# HAPROXY_CPU_LIMIT=2.0
# BACKEND_DISCOVERY_INTERVAL=30

# ============================================================================
# VALIDATION NOTES
# ============================================================================
# 
# Required Variables (must be set):
# - LETSENCRYPT_EMAIL
# - DOMAIN
# - DNS_PLUGIN
# - STATS_PASSWORD
# 
# Required Files (must exist):
# - dns-credentials/{provider}.ini (based on DNS_PLUGIN)
# 
# Recommended Security Changes:
# - Change STATS_PASSWORD to a strong password
# - Set appropriate ALERT_EMAIL
# - Review and customize CSP_POLICY for your applications
# - Set proper resource limits for your server capacity
# 
# ============================================================================