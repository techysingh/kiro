# HAProxy Wildcard SSL Configuration for LOCAL TESTING
# This configuration is for testing on local machine without real DNS/certificates

# ============================================================================
# CORE CONFIGURATION
# ============================================================================

# Let's Encrypt Configuration (for testing, we'll use staging)
LETSENCRYPT_EMAIL=test@example.com

# Domain Configuration (local testing)
DOMAIN=colakdo.local

# ============================================================================
# DNS PROVIDER CONFIGURATION - DISABLED FOR LOCAL TESTING
# ============================================================================

# DNS Provider Plugin (disabled for local testing)
DNS_PLUGIN=dns-godaddy

# Use standard certbot image for local testing (no real certificates)
CERTBOT_IMAGE=certbot/certbot:latest

# ============================================================================
# CERTIFICATE MANAGEMENT - LOCAL TESTING MODE
# ============================================================================

# Certificate Renewal Schedule (disabled for local testing)
RENEWAL_CRON_SCHEDULE=0 */12 * * *

# Certificate Monitoring Thresholds
CERT_WARNING_DAYS=30
CERT_CRITICAL_DAYS=7

# Development mode (use staging certificates)
DEVELOPMENT_MODE=true

# ============================================================================
# HAPROXY CONFIGURATION
# ============================================================================

# HAProxy Statistics Interface
HAPROXY_STATS_USER=admin
STATS_PASSWORD=LocalTestPassword123!

# ============================================================================
# BACKEND DISCOVERY
# ============================================================================

# Backend Service Discovery
BACKEND_DISCOVERY_ENABLED=true
BACKEND_DISCOVERY_INTERVAL=60
NETWORK_NAME=proxy-network

# Configuration Management
CONFIG_WATCH_INTERVAL=10
CONFIG_DEBOUNCE_TIME=30
MAX_CONFIG_RELOAD_ATTEMPTS=3
CONFIG_RELOAD_COOLDOWN=120

# ============================================================================
# MONITORING AND ALERTING - LOCAL TESTING
# ============================================================================

# Alert Configuration (disabled for local testing)
ALERT_EMAIL=
WEBHOOK_URL=

# Monitoring Intervals
HEALTH_CHECK_INTERVAL=30
CERTIFICATE_CHECK_INTERVAL=3600
HAPROXY_MONITOR_INTERVAL=300

# ============================================================================
# ERROR RECOVERY
# ============================================================================

# Error Recovery Configuration
RECOVERY_INTERVAL=300
MAX_RECOVERY_ATTEMPTS=3
RECOVERY_COOLDOWN=300

# ============================================================================
# DOCKER CONFIGURATION
# ============================================================================

# Container Resource Limits (reduced for local testing)
HAPROXY_MEMORY_LIMIT=256m
HAPROXY_CPU_LIMIT=0.5
CERTBOT_MEMORY_LIMIT=128m
CERTBOT_CPU_LIMIT=0.25

# Container Restart Policies
RESTART_POLICY=unless-stopped

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3
HEALTH_CHECK_START_PERIOD=40s