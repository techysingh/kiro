# Pi-hole Configuration
PIHOLE_PASSWORD=your_secure_password_here

# OpenVPN Configuration
OVPN_DATA=/path/to/your/openvpn/data
OVPN_SERVER_URL=vpn.irvh.bawas.com

# HAProxy Configuration
HAPROXY_STATS_USER=admin
HAPROXY_STATS_PASSWORD=your_secure_password_here

# Let's Encrypt Configuration
LETSENCRYPT_EMAIL=admin@irvh.bawas.com
DOMAIN=irvh.bawas.com

# Time Zone
TZ=America/New_York

# Network Configuration
# Change these if you need to use different ports
PIHOLE_PORT=53
HAPROXY_HTTP_PORT=80
HAPROXY_HTTPS_PORT=443
OPENVPN_PORT=1194 